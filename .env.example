# Public Vite client configuration. Firebase Web configuration is public, but
# values must still match the environment selected for the build.
VITE_APP_ENV=development
VITE_FIREBASE_API_KEY=YOUR_DEVELOPMENT_FIREBASE_WEB_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_DEVELOPMENT_FIREBASE_AUTH_DOMAIN
VITE_FIREBASE_PROJECT_ID=YOUR_DEVELOPMENT_FIREBASE_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_DEVELOPMENT_FIREBASE_STORAGE_BUCKET
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_DEVELOPMENT_FIREBASE_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_DEVELOPMENT_FIREBASE_APP_ID
VITE_FIREBASE_FUNCTIONS_REGION=YOUR_FIREBASE_FUNCTIONS_REGION
VITE_USE_FIREBASE_EMULATORS=false
VITE_ALLOWED_SCHOOL_DOMAIN=YOUR_SCHOOL_DOMAIN
VITE_FIREBASE_APP_CHECK_PROVIDER=YOUR_APP_CHECK_PROVIDER
VITE_FIREBASE_APP_CHECK_SITE_KEY=YOUR_APP_CHECK_PUBLIC_SITE_KEY

# Server-side configuration placeholders. Do not prefix server-only values with
# VITE_; place real values in Functions runtime configuration or Secret Manager.
ALLOWED_SCHOOL_DOMAIN=YOUR_SCHOOL_DOMAIN
FESTIVAL_TIMEZONE=YOUR_IANA_TIMEZONE
ADMIN_AUTHORIZATION_PLACEHOLDER=YOUR_ADMIN_AUTHORIZATION_SOURCE
RATING_PROVIDER_BASE_URL=YOUR_RATING_PROVIDER_BASE_URL
RATING_PROVIDER_AUTH_PLACEHOLDER=SET_IN_SECRET_MANAGER
NICKNAME_FORBIDDEN_WORDS=YOUR_SCHOOL_APPROVED_COMMA_SEPARATED_LIST
ENFORCE_APP_CHECK=false
