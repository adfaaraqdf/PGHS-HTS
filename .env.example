# Public Vite client configuration. The publishable key is intended for the
# browser and is still protected by Postgres grants and RLS.
VITE_APP_ENV=development
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
VITE_ALLOWED_SCHOOL_DOMAIN=pangyo.hs.kr

# Server/database-only settings. Never prefix secrets with VITE_. Configure
# Google OAuth secrets in the Supabase Dashboard or local CLI environment.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET
SUPABASE_SERVICE_ROLE_KEY=NEVER_EXPOSE_IN_BROWSER
ALLOWED_SCHOOL_DOMAIN=pangyo.hs.kr
FESTIVAL_TIMEZONE=Asia/Seoul
ADMIN_AUTHORIZATION_PLACEHOLDER=YOUR_ADMIN_AUTHORIZATION_SOURCE
RATING_PROVIDER_BASE_URL=YOUR_RATING_PROVIDER_BASE_URL
RATING_PROVIDER_AUTH_PLACEHOLDER=SET_IN_SUPABASE_VAULT
NICKNAME_FORBIDDEN_WORDS=YOUR_SCHOOL_APPROVED_COMMA_SEPARATED_LIST
