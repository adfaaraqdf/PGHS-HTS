{
  "name": "pghs-hts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test": "node --test test/*.test.js",
    "test:seed": "node --test test/seed/*.test.js",
    "test:rules": "node --test test/rules/*.test.js",
    "seed": "node scripts/seed-firestore.js",
    "seed:dry-run": "node scripts/seed-firestore.js --dry-run",
    "seed:validate": "node scripts/validate-official-catalog.js",
    "emulators": "firebase emulators:start --project demo-pghs-hts --only auth,firestore,functions",
    "test:emulator": "firebase emulators:exec --project demo-pghs-hts --only auth,firestore,functions \"npm test && npm run test:seed && npm run test:rules && npm --prefix functions run test:emulator\""
  },
  "dependencies": {
    "firebase": "12.16.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.0",
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "firebase-admin": "13.10.0",
    "firebase-tools": "15.23.0",
    "vite": "8.1.4"
  }
}
