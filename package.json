{
  "name": "pghs-hts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test": "node --test test/*.test.js",
    "test:db": "supabase test db",
    "test:local": "supabase db reset && npm test && npm run test:db",
    "seed:validate": "node scripts/validate-official-catalog.js",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint --local --level warning"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "supabase": "^2.109.1",
    "vite": "8.1.4"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.5"
  }
}
